generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(190)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          String    @default("admin") @db.VarChar(32)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

model Product {
  id              Int            @id @default(autoincrement())
  name            String         @db.VarChar(150)
  slug            String         @unique @db.VarChar(180)
  description     String?        @db.Text
  shortDescription String?       @map("short_description") @db.VarChar(255)
  fullDescription String?        @map("full_description") @db.Text
  category        String         @db.VarChar(100)
  price           Decimal        @db.Decimal(10, 2)
  salePrice       Decimal?       @map("sale_price") @db.Decimal(10, 2)
  sku             String         @unique @db.VarChar(100)
  stockQuantity   Int            @default(0) @map("stock_quantity")
  colors          String?        @db.VarChar(255)
  isFeatured      Boolean        @default(false) @map("is_featured")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  productImages     ProductImage[]
  productVariants   ProductVariant[]
  orderItems        OrderItem[]

  @@index([category])
  @@index([isFeatured])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imagePath String   @map("image_path") @db.VarChar(255)
  altText   String?  @map("alt_text") @db.VarChar(180)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  variantName   String   @map("variant_name") @db.VarChar(100)
  sku           String   @unique @db.VarChar(100)
  price         Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  imagePath     String?  @map("image_path") @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

model Order {
  id              Int          @id @default(autoincrement())
  orderNumber     String       @unique @map("order_number") @db.VarChar(40)
  customerName    String       @map("customer_name") @db.VarChar(120)
  customerEmail   String       @map("customer_email") @db.VarChar(190)
  customerPhone   String?      @map("customer_phone") @db.VarChar(30)
  shippingAddress String       @map("shipping_address") @db.Text
  city            String       @db.VarChar(100)
  additionalNotes String?      @map("additional_notes") @db.Text
  paymentMethod   String       @default("cash_on_delivery") @map("payment_method") @db.VarChar(32)
  status          String       @default("pending") @db.VarChar(32)
  paymentStatus   String       @default("cod_pending") @map("payment_status") @db.VarChar(32)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(10, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([customerEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int?     @map("product_id")
  variantId   Int?     @map("variant_id")
  productName String   @map("product_name") @db.VarChar(150)
  variantName String?  @map("variant_name") @db.VarChar(100)
  quantity    Int      @default(1) @db.UnsignedInt
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model ContactMessage {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(120)
  email       String    @db.VarChar(190)
  phone       String?   @db.VarChar(30)
  subject     String?   @db.VarChar(180)
  message     String    @db.Text
  status      String    @default("new") @db.VarChar(32)
  adminReply  String?   @map("admin_reply") @db.Text
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(190)
  isActive       Boolean  @default(true) @map("is_active")
  subscribedAt   DateTime @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("newsletter_subscribers")
}
